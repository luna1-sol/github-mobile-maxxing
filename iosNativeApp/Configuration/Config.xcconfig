// Shared build settings for iosNativeApp (native SwiftUI port).
// Machine- or person-specific values (TEAM_ID etc.) go in Local.xcconfig, which is gitignored.

// Maxxing Glass is an unofficial derivative of github-mobile-maxxing, so it uses its own Bundle ID
// (the upstream Compose app is io.github.neutron42-jp.gitmax) and can be installed next to it.
BUNDLE_ID = io.github.luna1-sol.maxxingglass
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// Liquid Glass (glassEffect, GlassEffectContainer, glass button styles, tab bar minimize) needs iOS 26.
IPHONEOS_DEPLOYMENT_TARGET = 26.0

// Client ID of the GitHub OAuth App used for Device Flow sign-in (Device Flow must be enabled on the app).
// TODO: replace with this app's own OAuth App; this is still upstream github-mobile-maxxing's ID.
OAUTH_CLIENT_ID = Ov23lihCAIZTj1Puaf9r

// Simulator builds need no signing; set TEAM_ID in Local.xcconfig for device builds.
TEAM_ID =

#include? "Local.xcconfig"
